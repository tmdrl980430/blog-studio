<Window x:Class="BlogStudio.Windows.Extras.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="블로그 통계" Width="720" Height="640" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" Background="#F6F7F9">
    <Window.Resources>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="블로그 통계" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="이 앱으로 쓰고 '올림' 표시한 글 기준이에요. 조회수는 각 블로그의 통계 메뉴에서 확인하세요."
                       FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,16" TextWrapping="Wrap" />

            <UniformGrid Columns="4">
                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="연속 기록" FontSize="12" Foreground="{StaticResource Muted}" /><TextBlock x:Name="Streak" FontSize="26" FontWeight="Bold" /><TextBlock x:Name="Best" FontSize="11" Foreground="{StaticResource Muted}" /></StackPanel></Border>
                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="이번 주 · 이번 달" FontSize="12" Foreground="{StaticResource Muted}" /><TextBlock x:Name="Recent" FontSize="26" FontWeight="Bold" /></StackPanel></Border>
                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="전체 글" FontSize="12" Foreground="{StaticResource Muted}" /><TextBlock x:Name="Total" FontSize="26" FontWeight="Bold" /></StackPanel></Border>
                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="아직 안 올린 글" FontSize="12" Foreground="{StaticResource Muted}" /><TextBlock x:Name="Unpublished" FontSize="26" FontWeight="Bold" Foreground="#B45309" /></StackPanel></Border>
            </UniformGrid>
            <UniformGrid Columns="2">
                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="네이버에 올림" FontSize="12" Foreground="{StaticResource Muted}" /><TextBlock x:Name="Naver" FontSize="22" FontWeight="Bold" Foreground="#03A94D" /></StackPanel></Border>
                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="티스토리에 올림" FontSize="12" Foreground="{StaticResource Muted}" /><TextBlock x:Name="Tistory" FontSize="22" FontWeight="Bold" Foreground="#EB531F" /></StackPanel></Border>
            </UniformGrid>

            <TextBlock Text="최근 30일" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,8" />
            <Border Style="{StaticResource Tile}" Margin="0,0,0,16">
                <StackPanel>
                    <ItemsControl x:Name="Days" Height="90">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border VerticalAlignment="Bottom" Margin="2,0" CornerRadius="3" Background="{Binding Brush}" Height="{Binding Height}" ToolTip="{Binding Tip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock x:Name="LastDay" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource Muted}" />
                        <TextBlock x:Name="FirstDay" FontSize="11" Foreground="{StaticResource Muted}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="카테고리별" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Border Style="{StaticResource Tile}">
                <ItemsControl x:Name="Categories">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="#2F5BEA" CornerRadius="3" Height="14" HorizontalAlignment="Left" Width="{Binding BarWidth}" />
                                <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
