<Window x:Class="BlogStudio.Windows.Extras.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="블로그 통계" Width="720" Height="640" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" Background="#F6F7F9">
    <Window.Resources>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="블로그 통계" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="이 앱으로 쓰고 '올림' 표시한 글 기준이에요. 조회수는 각 블로그의 통계 메뉴에서 확인하세요."
                       FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,16" TextWrapping="Wrap" />

            <UniformGrid Columns="4">
                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="연속 기록" FontSize="12" Foreground="{StaticResource Muted}" /><TextBlock x:Name="Streak" FontSize="26" FontWeight="Bold" /><TextBlock x:Name="Best" FontSize="11" Foreground="{StaticResource Muted}" /></StackPanel></Border>
                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="이번 주 · 이번 달" FontSize="12" Foreground="{StaticResource Muted}" /><TextBlock x:Name="Recent" FontSize="26" FontWeight="Bold" /></StackPanel></Border>
                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="전체 글" FontSize="12" Foreground="{StaticResource Muted}" /><TextBlock x:Name="Total" FontSize="26" FontWeight="Bold" /></StackPanel></Border>
                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="아직 안 올린 글" FontSize="12" Foreground="{StaticResource Muted}" /><TextBlock x:Name="Unpublished" FontSize="26" FontWeight="Bold" Foreground="#B45309" /></StackPanel></Border>
            </UniformGrid>
            <UniformGrid Columns="2">
                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="네이버에 올림" FontSize="12" Foreground="{StaticResource Muted}" /><TextBlock x:Name="Naver" FontSize="22" FontWeight="Bold" Foreground="#03A94D" /></StackPanel></Border>
                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="티스토리에 올림" FontSize="12" Foreground="{StaticResource Muted}" /><TextBlock x:Name="Tistory" FontSize="22" FontWeight="Bold" Foreground="#EB531F" /></StackPanel></Border>
            </UniformGrid>

            <!-- AI 직원: 성과 분석가 — 트랙별 기록으로 다음에 힘줄 트랙 최대 3줄. 줄을 누르면 그 트랙으로 기획자 열기 -->
            <Border x:Name="AnalystPanel" Style="{StaticResource Tile}" Margin="0,10,0,6">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="취소" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding AskAnalystCancelCommand}" />
                        <Button DockPanel.Dock="Right" Content="분석가에게 묻기" Style="{StaticResource SecondaryButton}"
                                ToolTip="트랙별 글 수·올림 표시·마지막 글 날짜로 다음에 힘줄 트랙을 추천받아요. 조회수는 보내지 않아요"
                                Command="{Binding AskAnalystCommand}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="성과 분석가" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AnalystStatus}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding AnalystPicks}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Padding="12,8" Margin="0,0,0,6" ToolTip="이 트랙으로 기획자에게 주제 받기"
                                        Click="AnalystPick_Click" Tag="{Binding}">
                                    <StackPanel>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap">
                                            <Run Text="{Binding TrackName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Direction, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 매일 자동 작성·발행 기록 (데이터 폴더 auto-log.txt, 최근 것부터) -->
            <StackPanel x:Name="AutoLogPanel">
                <DockPanel Margin="0,10,0,8">
                    <Button DockPanel.Dock="Right" Content="파일 열기" Style="{StaticResource SecondaryButton}"
                            ToolTip="auto-log.txt 전체를 메모장으로 열어요" Click="OpenAutoLog_Click" />
                    <TextBlock Text="자동 발행 기록" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <Border Style="{StaticResource Tile}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock x:Name="AutoLogEmpty" Text="아직 기록이 없어요. 설정에서 매일 자동 작성을 켜면 여기에 결과가 쌓여요."
                                   FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                        <ItemsControl x:Name="AutoLogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Top" />
                                        <Border Grid.Column="1" Background="{Binding Brush}" CornerRadius="3" Padding="4,1" Margin="0,0,8,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="White" />
                                        </Border>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Text="최근 30일" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,8" />
            <Border Style="{StaticResource Tile}" Margin="0,0,0,16">
                <StackPanel>
                    <ItemsControl x:Name="Days" Height="90">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border VerticalAlignment="Bottom" Margin="2,0" CornerRadius="3" Background="{Binding Brush}" Height="{Binding Height}" ToolTip="{Binding Tip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock x:Name="LastDay" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource Muted}" />
                        <TextBlock x:Name="FirstDay" FontSize="11" Foreground="{StaticResource Muted}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="카테고리별" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Border Style="{StaticResource Tile}">
                <ItemsControl x:Name="Categories">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="#2F5BEA" CornerRadius="3" Height="14" HorizontalAlignment="Left" Width="{Binding BarWidth}" />
                                <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="12" Foreground="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
