<Window x:Class="BlogStudio.Windows.Extras.InstaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="인스타 카드" Width="980" Height="760" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" Background="#F6F7F9">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="폴더 열기" Style="{StaticResource SecondaryButton}" Click="OpenFolder_Click" />
            <TextBlock Text="인스타 카드" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="  1080×1350 · 순서대로 올리면 돼요. 휴대폰으로는 폴더째 옮기거나 카카오톡 '나와의 채팅'으로 보내세요."
                       FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="캡션 복사" Style="{StaticResource PrimaryButton}" Click="CopyCaption_Click" VerticalAlignment="Top" Margin="10,0,0,0" />
            <TextBox x:Name="Caption" Style="{StaticResource FieldBox}" Height="130" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
        </DockPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Cards">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,12,0" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White" Padding="4">
                            <Image Source="{Binding}" Stretch="Uniform" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
