<Window x:Class="BlogStudio.Windows.Extras.TopicManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="주제 관리" Width="760" Height="720" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" Background="White">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="주제 관리" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="취소" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="저장" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True" />
        </StackPanel>

        <!-- 요일별 기술 트랙 -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="요일별 기술 글 (매일 자동 작성도 이 순서)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Schedule}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="{Binding Label}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding DataContext.TechTracks, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Selected}" DisplayMemberPath="Name" Height="30" FontSize="11" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- 트랙별 다음 주제 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="원래 순서로" Style="{StaticResource SecondaryButton}" Command="{Binding ResetTrackCommand}" />
            <TextBlock Text="다음에 쓸 주제" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" DisplayMemberPath="Name" Width="200" Height="30" HorizontalAlignment="Left" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding DoneText}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="맨 뒤에" Style="{StaticResource SecondaryButton}" Command="{Binding AddLastCommand}" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="바로 다음에" Style="{StaticResource PrimaryButton}" Command="{Binding AddNextCommand}" Margin="6,0,0,0" />
            <TextBox Text="{Binding NewTopic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     ToolTip="예: 다익스트라 최단 경로 / 연남동 라멘집 같은 정보 글 주제" />
        </DockPanel>

        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Upcoming}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EEF0F3" BorderThickness="0,0,0,1" Padding="12,6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="▲" Style="{StaticResource SecondaryButton}" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <Button Content="▼" Style="{StaticResource SecondaryButton}" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <Button Content="빼기" Style="{StaticResource SecondaryButton}" Padding="8,2"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
