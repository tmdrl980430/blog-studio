<Window x:Class="BlogStudio.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Width="500" Height="720" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" Background="White">
    <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorText}" Foreground="#B42318" FontSize="12" TextWrapping="Wrap" Margin="24,8,24,0" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,12,24,20">
            <Button Content="취소" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="저장" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,0">
                <TextBlock Text="설정" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

                <TextBlock Text="작성자 이름 (글 말투에 사용)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="0,0,0,12" />

                <TextBlock Text="네이버 블로그 ID (blog.naver.com/아이디)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding NaverBlogId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="0,0,0,12" />

                <TextBlock Text="티스토리 이름 (이름.tistory.com)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding TistoryName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="0,0,0,12" />

                <TextBlock Text="글 쓰는 AI" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding EngineOptions}" SelectedItem="{Binding Engine}" DisplayMemberPath="Label" Height="32" Margin="0,0,0,4" />
                <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10">
                    쓰고 있는 구독으로 돌아가요 (추가 요금 없음). 바꾼 뒤 처음이면 앱 위쪽 안내에서 설치·로그인을 해 주세요.
                </TextBlock>

                <StackPanel Visibility="{Binding IsClaude, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Claude 모델" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding ClaudeModel}" Height="32" Margin="0,0,0,4" />
                    <TextBlock Text="sonnet 권장 · opus는 품질↑ 사용량↑ · haiku는 가볍고 빠름" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,12" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsChatGpt, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="ChatGPT 모델 (비우면 Codex 기본)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ChatGptModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="0,0,0,12" />
                </StackPanel>

                <CheckBox Content="사용량 절약 모드 (권장)" IsChecked="{Binding SaveUsage}" Margin="0,0,0,2" />
                <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="22,0,0,20">
                    글쓰기에 필요 없는 기본 지시문·도구 설명을 빼고, ChatGPT는 생각(추론)을 짧게 해요.
                    제목 추천·인스타 문구 같은 가벼운 일은 항상 작은 모델로 해요.
                </TextBlock>

                <!-- 글 품질 -->
                <TextBlock Text="글 품질" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBlock Text="내 문체 예시 (내가 직접 쓴 글 한두 문단)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4">
                    말투·문장 길이·어미만 따라 해요. 내용은 가져오지 않아요. 최대 1,500자.
                </TextBlock>
                <TextBox Text="{Binding StyleSample, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                         Height="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxLength="1500" Margin="0,0,0,10" />
                <CheckBox Content="글 속 파이썬 코드를 이 PC에서 실행해 오류 찾기" IsChecked="{Binding CodeCheckEnabled}" Margin="0,0,0,2" />
                <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="22,0,0,20">
                    파이썬이 설치돼 있어야 해요. 임시 폴더에서 10초 안에만 돌리고, 파일·네트워크를 쓰는 코드는 실행하지 않아요.
                </TextBlock>

                <!-- 매일 자동 작성 -->
                <StackPanel Visibility="{Binding CanScheduleDaily, Converter={StaticResource BoolToVis}}" Margin="0,0,0,20">
                    <TextBlock Text="매일 자동 작성" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
                    <CheckBox Content="매일 정해진 시각에 오늘의 기술 글 만들기" IsChecked="{Binding DailyAutoEnabled}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="22,0,0,4">
                        <TextBlock Text="시각" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding DailyTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Width="80" />
                        <TextBlock Text="(24시간, 예: 07:30)" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="22,0,0,0">
                        그 시각에 앱이 열려 글을 만들어 둡니다. PC가 꺼져 있었으면 켠 뒤에 만들고, 오늘 글이 이미 있으면 건너뜁니다.
                        만든 뒤에는 AI 편집자가 검수하고 의견을 한 번 반영해요.
                    </TextBlock>

                    <CheckBox Content="검수를 통과한 글은 자동으로 발행" IsChecked="{Binding AutoPublishEnabled}" Margin="0,12,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="22,0,0,4">
                        <CheckBox Content="티스토리" IsChecked="{Binding AutoPublishTistory}" IsEnabled="{Binding AutoPublishEnabled}" Margin="0,0,16,0" />
                        <CheckBox Content="네이버 블로그" IsChecked="{Binding AutoPublishNaver}" IsEnabled="{Binding AutoPublishEnabled}" />
                    </StackPanel>
                    <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="22,0,0,0">
                        편집자가 '다시 쓰기'로 판정했거나 '(확인 필요)'·코드 오류·빈 사진 자리가 남은 글은 발행하지 않고 보류해요.
                        공식 글쓰기 API가 없어 앱 안 브라우저가 화면을 대신 눌러요. 자동 채우기 창에서 두 블로그에 한 번 로그인해 두세요.
                        결과는 데이터 폴더의 auto-log.txt에 남아요.
                    </TextBlock>
                </StackPanel>

                <!-- 이미지 -->
                <TextBlock Text="이미지" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />

                <CheckBox Content="썸네일 자동 생성 (타이포 카드, 무료)" IsChecked="{Binding ThumbnailEnabled}" Margin="0,0,0,6" />
                <TextBlock Text="썸네일에 넣을 블로그 이름 (비우면 작성자 이름)" FontSize="12" Margin="22,0,0,4" />
                <TextBox Text="{Binding BlogDisplayName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="22,0,0,12" />

                <CheckBox Content="개념 그림·다이어그램 (Claude가 그림, 무료)" IsChecked="{Binding DiagramsEnabled}" Margin="0,0,0,16" />

                <TextBlock Text="무료 사진 — Pexels API 키" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4">
                    pexels.com/api 에서 무료로 발급. 넣어 두면 글마다 어울리는 사진 1장과 출처가 들어갑니다.
                </TextBlock>
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="지우기" Style="{StaticResource SecondaryButton}" Command="{Binding ClearPexelsKeyCommand}" Margin="6,0,0,0" />
                    <TextBox Text="{Binding PexelsKeyInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                </DockPanel>
                <TextBlock Text="{Binding PexelsKeyStatus}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,16" />

                <CheckBox Content="AI 이미지 생성 (OpenAI, 쓴 만큼 과금)" IsChecked="{Binding AiImagesEnabled}" Margin="0,0,0,4" />
                <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="22,0,0,4">
                    본인 OpenAI API 키로 글마다 일러스트 1장. 품질 low가 가장 저렴합니다 (Claude Pro와 별개 요금).
                </TextBlock>
                <DockPanel Margin="22,0,0,4">
                    <Button DockPanel.Dock="Right" Content="지우기" Style="{StaticResource SecondaryButton}" Command="{Binding ClearOpenAiKeyCommand}" Margin="6,0,0,0" />
                    <TextBox Text="{Binding OpenAiKeyInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
                </DockPanel>
                <TextBlock Text="{Binding OpenAiKeyStatus}" FontSize="11" Foreground="{StaticResource Muted}" Margin="22,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="22,0,0,16">
                    <TextBlock Text="품질" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding OpenAiImageQuality}" Width="120" Height="30" />
                </StackPanel>

                <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8">
                    <Run Text="API 키는 이 PC의 Windows 계정으로 암호화해 저장합니다. 데이터 위치: " /><Run Text="{Binding DataFolder, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
