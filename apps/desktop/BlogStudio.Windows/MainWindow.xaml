<Window x:Class="BlogStudio.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Blog Studio" Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" Background="{StaticResource Ground}"
        Foreground="{StaticResource Ink}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel>
        <!-- 상단 바 -->
        <Border DockPanel.Dock="Top" Height="48" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0" LastChildFill="False">
                <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource Accent}" VerticalAlignment="Center">
                    <TextBlock Text="B" Foreground="White" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Blog Studio" FontWeight="Bold" FontSize="14" Margin="10,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="설정" Style="{StaticResource SecondaryButton}"
                        Click="OpenSettings_Click" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- 하단 상태 바 -->
        <Border DockPanel.Dock="Bottom" Height="32" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,0">
                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#B42318" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProviderReady}" Value="True">
                                    <Setter Property="Fill" Value="#157F3B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ProviderStatus}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Ink}" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 채널 -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <StackPanel Margin="12,16">
                    <TextBlock Text="채널" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="8,0,0,8" />
                    <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="10,0" Height="40">
                        <TextBlock Text="{Binding ThemeName}" FontWeight="Bold" Foreground="#1E3FB0" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="리뷰·패션 채널은 다음 단계에서 추가돼요" FontSize="11" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" Margin="8,10,8,0" />
                </StackPanel>
            </Border>

            <!-- 오늘의 주제 + 생성 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <!-- Claude Code가 없을 때: 설치·로그인 안내 -->
                    <Border Background="#FFF6E5" BorderBrush="#F2C879" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18"
                            Visibility="{Binding ShowClaudeSetup, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Claude Code가 필요해요" FontWeight="Bold" FontSize="14" />
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#5B4A1F" Margin="0,4,0,10"
                                       Text="Claude Pro 구독으로 글을 쓰려면 이 PC에 Claude Code가 있어야 해요. 자동 설치를 누르면 공식 설치 프로그램이 실행되고, 끝나면 로그인 창이 열립니다." />
                            <WrapPanel>
                                <Button Content="자동 설치" Style="{StaticResource PrimaryButton}" Command="{Binding InstallClaudeCodeCommand}" Margin="0,0,6,6" />
                                <Button Content="로그인 창 열기" Style="{StaticResource SecondaryButton}" Command="{Binding OpenClaudeLoginCommand}" Margin="0,0,6,6" />
                                <Button Content="다시 확인" Style="{StaticResource SecondaryButton}" Command="{Binding CheckProviderCommand}" Margin="0,0,0,6" />
                            </WrapPanel>
                            <ProgressBar IsIndeterminate="True" Height="3"
                                         Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <TextBlock FontSize="12" Foreground="{StaticResource Muted}">
                        <Run Text="{Binding DateLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TrackName, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding TopicTitle}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,16" />

                    <TextBlock Text="추가 요청 (선택)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding ExtraRequest, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                             Height="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="글 생성하기 · Claude Code (Pro)" Style="{StaticResource PrimaryButton}" Height="44"
                                Command="{Binding GenerateCommand}" />
                        <Button Grid.Column="1" Content="취소" Style="{StaticResource SecondaryButton}" Height="44" Margin="8,0,0,0"
                                Command="{Binding GenerateCancelCommand}"
                                Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                                 Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="다음 주제" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,24,0,8" />
                    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
                        <ItemsControl ItemsSource="{Binding UpcomingTopics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#EEF0F3" BorderThickness="0,0,0,1" Padding="12,10">
                                        <TextBlock Text="{Binding Label}" FontSize="13" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 미리보기 -->
            <DockPanel Grid.Column="2" Margin="0,20,20,20">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="미리보기" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="블로그 보기" Style="{StaticResource SecondaryButton}" Command="{Binding ShowRenderedCommand}" Margin="0,0,4,0" />
                    <Button Content="마크다운" Style="{StaticResource SecondaryButton}" Command="{Binding ShowMarkdownCommand}" Margin="0,0,16,0" />
                    <Button Content="제목·태그 복사" Style="{StaticResource SecondaryButton}" Command="{Binding CopyTitleAndTagsCommand}" Margin="0,0,4,0" />
                    <Button Content="마크다운 복사" Style="{StaticResource SecondaryButton}" Command="{Binding CopyMarkdownCommand}" Margin="0,0,4,0" />
                    <Button Content="본문 복사 + 티스토리" Style="{StaticResource SecondaryButton}" Command="{Binding CopyForTistoryCommand}" Margin="0,0,4,0" />
                    <Button Content="본문 복사 + 네이버" Style="{StaticResource PrimaryButton}" Command="{Binding CopyForNaverCommand}" />
                </WrapPanel>
                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="1">
                    <wv2:WebView2 x:Name="Preview" />
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
