<Window x:Class="BlogStudio.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Blog Studio" Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" Background="{StaticResource Ground}"
        Foreground="{StaticResource Ink}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel>
        <!-- 상단 바 -->
        <Border DockPanel.Dock="Top" Height="48" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0" LastChildFill="False">
                <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource Accent}" VerticalAlignment="Center">
                    <TextBlock Text="B" Foreground="White" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Blog Studio" FontWeight="Bold" FontSize="14" Margin="10,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="설정" Style="{StaticResource SecondaryButton}"
                        Click="OpenSettings_Click" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="통계" Style="{StaticResource SecondaryButton}"
                        Click="OpenStats_Click" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button DockPanel.Dock="Right" Content="주제 관리" Style="{StaticResource SecondaryButton}"
                        Click="OpenTopics_Click" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button DockPanel.Dock="Right" Content="블로그 준비" ToolTip="네이버·티스토리 개설·꾸미기 가이드와 복사용 CSS" Style="{StaticResource SecondaryButton}"
                        Click="OpenGuides_Click" VerticalAlignment="Center" Margin="0,0,6,0" />
                <!-- 새 버전 알림 (GitHub Releases) -->
                <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="12,4,4,4"
                        Margin="0,0,10,0" VerticalAlignment="Center"
                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding UpdateBannerText}" Foreground="#1E3FB0" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="재시작하여 업데이트" Style="{StaticResource PrimaryButton}" MinHeight="30"
                                Command="{Binding ApplyUpdateCommand}" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- 하단 상태 바 -->
        <Border DockPanel.Dock="Bottom" Height="32" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,0">
                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#B42318" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProviderReady}" Value="True">
                                    <Setter Property="Fill" Value="#157F3B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ProviderStatus}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Ink}" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 채널 -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <StackPanel Margin="12,16">
                    <TextBlock Text="채널" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="8,0,0,8" />
                    <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="10,0" Height="40">
                        <TextBlock Text="{Binding ThemeName}" FontWeight="Bold" Foreground="#1E3FB0" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="리뷰·패션 채널은 다음 단계에서 추가돼요" FontSize="11" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" Margin="8,10,8,0" />
                </StackPanel>
            </Border>

            <!-- 오늘의 주제 + 생성 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <!-- Claude Code가 없을 때: 설치·로그인 안내 -->
                    <Border Background="#FFF6E5" BorderBrush="#F2C879" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18"
                            Visibility="{Binding ShowClaudeSetup, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SetupTitle}" FontWeight="Bold" FontSize="14" />
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#5B4A1F" Margin="0,4,0,10"
                                       Text="{Binding SetupHelp}" />
                            <WrapPanel>
                                <Button Content="자동 설치" Style="{StaticResource PrimaryButton}" Command="{Binding InstallClaudeCodeCommand}" Margin="0,0,6,6" />
                                <Button Content="로그인 창 열기" Style="{StaticResource SecondaryButton}" Command="{Binding OpenClaudeLoginCommand}" Margin="0,0,6,6" />
                                <Button Content="다시 확인" Style="{StaticResource SecondaryButton}" Command="{Binding CheckProviderCommand}" Margin="0,0,0,6" />
                            </WrapPanel>
                            <ProgressBar IsIndeterminate="True" Height="3"
                                         Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="카테고리" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label"
                              Height="34" Margin="0,0,0,16" VerticalContentAlignment="Center" />

                    <TextBlock FontSize="12" Foreground="{StaticResource Muted}">
                        <Run Text="{Binding DateLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TrackName, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding TopicTitle}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,8" />

                    <!-- AI 직원: 기획자 — 오늘 주제 대신 검색될 만한 주제 후보 (커리큘럼 순서는 그대로) -->
                    <Button Content="기획자에게 주제 받기" ToolTip="이 트랙에서 검색될 만한 주제 5개를 추천받아요. '추가 요청'에 적은 내용도 참고해요"
                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Command="{Binding AskPlannerCommand}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding TopicIdeas}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Padding="12,8" Margin="0,0,0,6"
                                        ToolTip="이 주제로 오늘 글 쓰기"
                                        Command="{Binding DataContext.PickTopicIdeaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Topic}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap">
                                            <Run Text="{Binding Keyword, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Reason, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="8" />

                    <!-- 일상·리뷰: 메모가 있으면 후기, 비우면 위 주제로 정보 글 -->
                    <StackPanel Visibility="{Binding IsMemoCategory, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                        <TextBlock Text="이름 (가게·장소·제품, 선택)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox Text="{Binding MemoName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="0,0,0,12" />
                        <TextBlock Text="내 메모 (비우면 정보 글)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding MemoHint}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBox Text="{Binding MemoText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                 Height="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                        <DockPanel Margin="0,12,0,6">
                            <Button DockPanel.Dock="Right" Content="사진 추가" Style="{StaticResource SecondaryButton}" Command="{Binding AddPhotosCommand}" />
                            <TextBlock Text="내 사진 (최대 10장, 글 속 어울리는 자리에 들어가요)" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding MemoPhotos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6">
                                        <Image DockPanel.Dock="Left" Width="56" Height="40" Stretch="UniformToFill" Margin="0,0,8,0" Source="{Binding FullPath}" />
                                        <Button DockPanel.Dock="Right" Content="빼기" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Text="추가 요청 (선택)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding ExtraRequest, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                             Height="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="{Binding GenerateLabel}" Style="{StaticResource PrimaryButton}" Height="44"
                                Command="{Binding GenerateCommand}" />
                        <Button Grid.Column="1" Content="취소" Style="{StaticResource SecondaryButton}" Height="44" Margin="8,0,0,0"
                                Command="{Binding CancelWorkCommand}"
                                Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                                 Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}" />

                    <!-- 이번 글의 이미지: 블로그 편집기의 [이미지 N] 자리에 하나씩 붙여넣기 -->
                    <StackPanel Visibility="{Binding HasImages, Converter={StaticResource BoolToVis}}" Margin="0,24,0,0">
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="폴더 열기" Style="{StaticResource SecondaryButton}" Command="{Binding OpenImagesFolderCommand}" />
                            <TextBlock Text="이미지" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="본문의 [이미지 N] 자리에서 '복사'한 이미지를 Ctrl+V로 붙여넣으세요." FontSize="11"
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
                            <ItemsControl ItemsSource="{Binding Images}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#EEF0F3" BorderThickness="0,0,0,1" Padding="10">
                                            <DockPanel>
                                                <Image DockPanel.Dock="Left" Width="72" Height="44" Stretch="UniformToFill" Margin="0,0,10,0" Source="{Binding FullPath}" />
                                                <Button DockPanel.Dock="Right" Content="복사" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.CopyImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Caption}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="다음 주제" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,24,0,8" />
                    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
                        <ItemsControl ItemsSource="{Binding UpcomingTopics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#EEF0F3" BorderThickness="0,0,0,1" Padding="12,10">
                                        <TextBlock Text="{Binding Label}" FontSize="13" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="지난 글" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,24,0,8" />
                    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" MaxHeight="320">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RecentPosts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenPostCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                Background="Transparent" BorderBrush="#EEF0F3" BorderThickness="0,0,0,1" Padding="12,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource Muted}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 미리보기 -->
            <DockPanel Grid.Column="2" Margin="0,20,20,20">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="미리보기" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="블로그 보기" Command="{Binding ShowRenderedCommand}" Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRenderedMode}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                        <Setter Property="Foreground" Value="#1E3FB0" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="마크다운" Command="{Binding ShowMarkdownCommand}" Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMarkdownMode}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                        <Setter Property="Foreground" Value="#1E3FB0" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="브라우저로 열기" Style="{StaticResource SecondaryButton}" Command="{Binding OpenPreviewInBrowserCommand}" Margin="0,0,16,0" />
                    <Button Content="제목·태그 복사" Style="{StaticResource SecondaryButton}" Command="{Binding CopyTitleAndTagsCommand}" Margin="0,0,4,0" />
                    <Button Content="마크다운 복사" Style="{StaticResource SecondaryButton}" Command="{Binding CopyMarkdownCommand}" Margin="0,0,4,0" />
                    <CheckBox Content="네이버에 올림" IsChecked="{Binding IsPublishedNaver}" IsEnabled="{Binding HasPost}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox Content="티스토리에 올림" IsChecked="{Binding IsPublishedTistory}" IsEnabled="{Binding HasPost}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="티스토리 자동 채우기" ToolTip="앱 안 브라우저에서 제목·본문·이미지·태그를 채워요. 발행은 직접" Style="{StaticResource PrimaryButton}" Command="{Binding AutoFillTistoryCommand}" Margin="0,0,4,0" />
                    <Button Content="네이버 자동 채우기" ToolTip="앱 안 브라우저에서 제목·본문·이미지를 채워요. 발행은 직접" Style="{StaticResource PrimaryButton}" Command="{Binding AutoFillNaverCommand}" Margin="0,0,16,0" />
                    <Button Content="HTML 복사 + 티스토리" ToolTip="티스토리 글쓰기에서 HTML 모드로 바꾼 뒤 붙여넣으면 표가 깨지지 않아요" Style="{StaticResource SecondaryButton}" Command="{Binding CopyForTistoryCommand}" Margin="0,0,4,0" />
                    <Button Content="본문 복사 + 네이버" Style="{StaticResource SecondaryButton}" Command="{Binding CopyForNaverCommand}" />
                </WrapPanel>
                <!-- 발행 전 점검 -->
                <Expander DockPanel.Dock="Top" Header="{Binding CheckSummary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"
                          Visibility="{Binding HasPost, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Checks}" Margin="4,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10,4" Margin="0,0,6,6" Background="#EEF6EE">
                                    <TextBlock FontSize="12" FontWeight="Normal" Foreground="#1F5130">
                                        <Run Text="{Binding Icon, Mode=OneWay}" FontWeight="Bold" /> <Run Text="{Binding Text, Mode=OneWay}" />
                                    </TextBlock>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                    <Setter Property="Background" Value="#FFF4E5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!-- 코드 오류 고치기 · 제목 후보 -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding HasPost, Converter={StaticResource BoolToVis}}">
                    <Button Content="코드 오류 고치기" Style="{StaticResource PrimaryButton}" Command="{Binding FixCodeErrorsCommand}" Margin="0,0,6,6"
                            Visibility="{Binding HasCodeErrors, Converter={StaticResource BoolToVis}}" />
                    <Button Content="편집자 검수" ToolTip="AI 편집자가 사실·지어낸 경험·광고 정책·검색·문장을 보고 고칠 점을 알려 줘요" Style="{StaticResource PrimaryButton}" Command="{Binding ReviewWithEditorCommand}" Margin="0,0,6,6" />
                    <Button Content="제목 추천" ToolTip="검색이 잘 되는 제목 후보 5개" Style="{StaticResource SecondaryButton}" Command="{Binding SuggestTitlesCommand}" Margin="0,0,6,6" />
                    <ItemsControl ItemsSource="{Binding TitleIdeas}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" ToolTip="이 제목으로 바꾸기" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"
                                        Command="{Binding DataContext.ApplyTitleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>

                <!-- AI 직원: 편집자 검수 결과 -->
                <Border DockPanel.Dock="Top" Background="#F3F6FD" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                        Visibility="{Binding HasEditorReview, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="의견대로 고치기" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyEditorNotesCommand}"
                                    Visibility="{Binding HasEditorNotes, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding EditorVerdict}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding EditorNotes}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0">
                                        <Run Text="• " /><Run Text="{Binding Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Claude로 고치기 / 직접 편집 -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" Visibility="{Binding HasPost, Converter={StaticResource BoolToVis}}">
                    <Button DockPanel.Dock="Right" Content="인스타 카드" ToolTip="이 글을 1080×1350 카드 뉴스와 캡션으로" Style="{StaticResource SecondaryButton}" Command="{Binding MakeInstaCardsCommand}" Margin="6,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="직접 편집" Style="{StaticResource SecondaryButton}" Command="{Binding StartEditCommand}" Margin="6,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Claude로 고치기" Style="{StaticResource PrimaryButton}" Command="{Binding ReviseCommand}" Margin="6,0,0,0" />
                    <TextBox Text="{Binding RevisionRequest, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                             ToolTip="예: 도입부를 두 문장으로 줄여 줘 / 비교 표 하나 추가 / 제목을 더 검색되게" />
                </DockPanel>

                <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="1">
                    <Grid>
                        <wv2:WebView2 x:Name="Preview" />
                        <!-- 직접 편집 (WebView2 위에는 겹쳐 그릴 수 없어서 편집 중엔 미리보기를 숨김) -->
                        <DockPanel x:Name="EditPanel" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" Margin="16" Background="White">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="제목" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="0,0,0,10" />
                                <TextBlock Text="태그 (쉼표로 구분)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditTags, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Margin="0,0,0,10" />
                                <TextBlock Text="본문 (마크다운 · ![…](images/…) 줄은 이미지 자리)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="취소" Style="{StaticResource SecondaryButton}" Command="{Binding CancelEditCommand}" Margin="0,0,8,0" />
                                <Button Content="저장" Style="{StaticResource PrimaryButton}" Command="{Binding SaveEditCommand}" />
                            </StackPanel>
                            <TextBox Text="{Binding EditBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Malgun Gothic" FontSize="13"
                                     Padding="8" BorderBrush="{StaticResource Line}" />
                        </DockPanel>
                        <!-- WebView2를 쓸 수 없을 때 안내 -->
                        <StackPanel x:Name="PreviewFallback" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                            <TextBlock Text="앱 안 미리보기를 표시할 수 없어요" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding PreviewUnavailableMessage}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"
                                       TextAlignment="Center" Margin="0,6,0,12" />
                            <Button Content="브라우저로 열기" Style="{StaticResource PrimaryButton}" Command="{Binding OpenPreviewInBrowserCommand}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
